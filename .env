# Supabase Configuration
# Copy this file to .env and fill in your credentials

# === LOCAL DEVELOPMENT ===
# When running Supabase locally with Docker
# ServiceGenie Local Development
EXPO_PUBLIC_SUPABASE_URL=http://localhost:3001
EXPO_PUBLIC_SUPABASE_ANON_KEY=local-dev-key
EXPO_PUBLIC_API_BASE=http://localhost:3001
# Get the real anon key from: http://localhost:8000 > Settings > API

# === CLOUD ===
# When using Supabase cloud (https://supabase.com)
# EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
